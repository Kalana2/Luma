{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$userId": {
        ".validate": "newData.hasChildren(['id','name','email'])"
      }
    },
    "floors": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$floorId": {
        ".validate": "newData.hasChildren(['name','rooms'])"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "devices": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$deviceId": {
        ".validate": "newData.hasChildren(['type','name','status'])",
        "state": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.val() == null"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() || newData.val() == null"
        }
      }
    },
    "alerts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reports": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
